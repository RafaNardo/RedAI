{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CreativeRevisionPlan",
  "type": "object",
  "required": ["actions", "summary"],
  "properties": {
    "summary": {"type": "string"},
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "instruction"],
        "properties": {
          "type": {"enum": ["CHANGE_COPY", "CHANGE_LAYOUT", "REGENERATE_IMAGE", "CHANGE_COLORS", "CHANGE_TYPOGRAPHY", "CHANGE_ASSET", "NO_CHANGE"]},
          "instruction": {"type": "string"},
          "changes": {"type": ["object", "null"]}
        }
      }
    }
  }
}
