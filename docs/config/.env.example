# App
ASPNETCORE_ENVIRONMENT=Development
NEXT_PUBLIC_API_BASE_URL=http://localhost:5080/api

# AI
AI_MODE=mock
# Não coloque chave aqui. Em desenvolvimento .NET, use:
# dotnet user-secrets set "ai-api-key" "sua-chave" --project src/RedAI.Api
# O backend deve ler esse secret e nunca expô-lo ao frontend.
AI_REASONING_MODEL=
AI_FAST_MODEL=
AI_IMAGE_MODEL=
AI_GENERATION_CONCURRENCY=3

# Database
POSTGRES_DB=redai
POSTGRES_USER=redai
POSTGRES_PASSWORD=redai_dev
ConnectionStrings__Default=Host=postgres;Port=5432;Database=redai;Username=redai;Password=redai_dev

# Storage
ASSET_STORAGE_MODE=local
ASSET_STORAGE_PATH=/data/assets
ASSET_PUBLIC_BASE_URL=http://localhost:5080/assets

# Demo
DEMO_MODE=true
