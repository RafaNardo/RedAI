{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BrandProfile",
  "type": "object",
  "required": ["brandName", "industry", "summary", "confidence", "visualIdentity", "voice", "audiences", "products", "contentAnalysis", "restrictions"],
  "properties": {
    "brandName": {"type": "string"},
    "industry": {"type": "string"},
    "summary": {"type": "string"},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "visualIdentity": {
      "type": "object",
      "required": ["colors", "visualStyle", "imageStyle", "layoutCharacteristics"],
      "properties": {
        "colors": {"type": "array", "items": {"type": "object", "required": ["hex", "role", "confidence"], "properties": {"hex": {"type": "string"}, "role": {"type": "string"}, "confidence": {"type": "number", "minimum": 0, "maximum": 1}}}},
        "visualStyle": {"type": "array", "items": {"type": "string"}},
        "imageStyle": {"type": "array", "items": {"type": "string"}},
        "layoutCharacteristics": {"type": "array", "items": {"type": "string"}},
        "typographyObservations": {"type": "array", "items": {"type": "string"}}
      }
    },
    "voice": {
      "type": "object",
      "required": ["traits", "formality", "energy", "avoid"],
      "properties": {
        "traits": {"type": "array", "items": {"type": "string"}},
        "formality": {"type": "number", "minimum": 0, "maximum": 1},
        "energy": {"type": "number", "minimum": 0, "maximum": 1},
        "avoid": {"type": "array", "items": {"type": "string"}}
      }
    },
    "audiences": {"type": "array", "items": {"type": "object", "required": ["name", "description", "confidence"], "properties": {"name": {"type": "string"}, "description": {"type": "string"}, "confidence": {"type": "number", "minimum": 0, "maximum": 1}}}},
    "products": {"type": "array", "items": {"type": "object", "required": ["name", "confidence"], "properties": {"name": {"type": "string"}, "confidence": {"type": "number", "minimum": 0, "maximum": 1}}}},
    "contentAnalysis": {"type": "object", "required": ["currentPillars", "strengths", "opportunities", "recommendations"], "properties": {"currentPillars": {"type": "array", "items": {"type": "string"}}, "strengths": {"type": "array", "items": {"type": "string"}}, "opportunities": {"type": "array", "items": {"type": "string"}}, "recommendations": {"type": "array", "items": {"type": "string"}}}},
    "restrictions": {"type": "array", "items": {"type": "string"}}
  }
}
